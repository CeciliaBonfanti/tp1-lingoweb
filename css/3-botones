/*3. BOTONES, INPUTS E IMÁGENES*/

/* Base de todos los botones */
.btn {
  display: inline-block;
  font-family: var(--fuente-principal);
  font-size: var(--texto-normal);
  font-weight: 600;
  text-align: center;
  padding: 12px var(--espaciado-grande);
  border-radius: var(--radio-borde);
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  text-decoration: none;
}

/* Botón Primario con Glow Esmeralda */
.btn-primario {
  background-color: var(--color-primario);
  color: var(--color-fondo); /* Texto oscuro para contrastar con el botón brillante */
}

.btn-primario:hover {
  background-color: var(--color-primario-hover);
  box-shadow: 0 0 15px rgba(56, 199, 180, 0.4);
}

.btn-primario:active {
  transform: scale(0.98);
}

/* Botón Secundario con Glow Naranja */
.btn-secundario {
  background-color: var(--color-secundario);
  color: var(--color-fondo);
}

.btn-secundario:hover {
  background-color: var(--color-secundario-hover);
  box-shadow: 0 0 15px rgba(244, 162, 97, 0.4);
}

.btn-secundario:active {
  transform: scale(0.98);
}

/* Campos de Formulario (Vista de Login / Perfil) */
.input-control {
  width: 100%;
  font-family: var(--fuente-principal);
  font-size: var(--texto-normal);
  padding: 12px var(--espaciado-medio);
  background-color: var(--color-fondo); /* Más oscuro que la tarjeta para dar profundidad */
  border: 1px solid var(--color-borde);
  border-radius: 8px;
  color: var(--color-texto-principal);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  margin-bottom: var(--espaciado-medio);
}

.input-control:focus {
  border-color: var(--color-primario);
  box-shadow: 0 0 8px rgba(56, 199, 180, 0.2);
}

/* Imágenes e Íconos */
.img-fluida {
  max-width: 100%;
  height: auto;
  display: block;
  border-radius: 8px;
}